.index-page {
  background: transparent;
}

.hero {
  position: relative;
  overflow: hidden;
  min-height: 620rpx;
  padding: 34rpx 38rpx 58rpx;
  background:
    radial-gradient(circle at 82% 16%, rgba(202, 168, 104, 0.22), transparent 24%),
    radial-gradient(circle at 30% 92%, rgba(28, 137, 153, 0.2), transparent 31%),
    linear-gradient(145deg, #002b50 0%, #005bac 60%, #16738a 100%);
  color: #ffffff;
}

.hero::before {
  position: absolute;
  right: -20rpx;
  bottom: 0;
  width: 360rpx;
  height: 250rpx;
  background: repeating-linear-gradient(
    90deg,
    rgba(212, 232, 247, 0.1) 0,
    rgba(212, 232, 247, 0.1) 2rpx,
    transparent 2rpx,
    transparent 31rpx
  );
  transform: skewX(-5deg);
  opacity: 0.9;
  pointer-events: none;
  content: "";
}

.hero::after {
  position: absolute;
  right: -145rpx;
  bottom: -180rpx;
  width: 420rpx;
  height: 420rpx;
  border: 1rpx solid rgba(216, 188, 132, 0.16);
  border-radius: 50%;
  content: "";
}

.hero-orbit {
  position: absolute;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  pointer-events: none;
}

.orbit-one {
  top: 65rpx;
  right: -135rpx;
  width: 360rpx;
  height: 360rpx;
}

.orbit-two {
  top: 132rpx;
  right: -60rpx;
  width: 210rpx;
  height: 210rpx;
  background: rgba(255, 255, 255, 0.035);
}

.brand-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.unofficial-badge {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 8rpx 14rpx 8rpx 8rpx;
  border: 1rpx solid rgba(224, 194, 137, 0.36);
  border-radius: 12rpx;
  background: rgba(214, 180, 116, 0.12);
  color: #f1dfb9;
  font-size: 18rpx;
  font-weight: 550;
  letter-spacing: 0.5rpx;
}

.unofficial-badge-mark {
  margin-right: 9rpx;
  padding: 3rpx 9rpx;
  border-radius: 7rpx;
  background: #ddbd82;
  color: #17324d;
  font-size: 16rpx;
  font-weight: 750;
  letter-spacing: 1rpx;
}

.brand-mark {
  position: relative;
  display: flex;
  width: 70rpx;
  height: 70rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.46);
  border-radius: 22rpx 22rpx 22rpx 8rpx;
  background: rgba(255, 255, 255, 0.12);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
}

.brand-mark-letter {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1;
}

.brand-mark-line {
  position: absolute;
  right: 13rpx;
  bottom: 12rpx;
  width: 20rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: #9cc9ff;
}

.brand-copy {
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
}

.brand-name {
  font-size: 28rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
}

.brand-en {
  margin-top: 1rpx;
  color: rgba(224, 239, 255, 0.68);
  font-size: 17rpx;
  letter-spacing: 2.4rpx;
}

.brand-motto {
  margin-top: 5rpx;
  color: #b9d7f4;
  font-family: "Songti SC", "SimSun", serif;
  font-size: 18rpx;
  letter-spacing: 3rpx;
}

.hero-address {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  color: rgba(189, 218, 247, 0.72);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 17rpx;
  letter-spacing: 2.8rpx;
}

.hero-title {
  position: relative;
  z-index: 1;
  width: 610rpx;
  margin-top: 14rpx;
  font-size: 55rpx;
  font-weight: 720;
  line-height: 1.28;
  letter-spacing: -1rpx;
}

.hero-title text {
  display: block;
  color: #a9d1ff;
}

.hero-copy {
  position: relative;
  z-index: 1;
  width: 610rpx;
  margin-top: 22rpx;
  color: rgba(231, 241, 253, 0.73);
  font-size: 25rpx;
  line-height: 1.8;
}

.hero-watermark {
  position: absolute;
  right: -8rpx;
  bottom: -28rpx;
  color: transparent;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 235rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -12rpx;
  -webkit-text-stroke: 1rpx rgba(213, 187, 134, 0.2);
  pointer-events: none;
}

.hero-stats {
  position: relative;
  z-index: 1;
  display: flex;
  width: 480rpx;
  align-items: center;
  justify-content: space-between;
  margin-top: 38rpx;
}

.hero-stat {
  display: flex;
  flex-direction: column;
}

.stat-value {
  font-size: 37rpx;
  font-weight: 720;
  line-height: 1;
}

.stat-label {
  margin-top: 8rpx;
  color: rgba(223, 238, 255, 0.65);
  font-size: 20rpx;
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.17);
}

.content {
  position: relative;
  z-index: 2;
  margin-top: -28rpx;
  padding: 0 28rpx 24rpx;
}

.cohort-panel {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #d9d4c8;
  border-radius: 22rpx;
  background: rgba(255, 253, 248, 0.96);
  box-shadow: 0 12rpx 30rpx rgba(22, 54, 96, 0.09);
}

.cohort-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.cohort-kicker {
  color: #8f6d37;
  font-size: 16rpx;
  font-weight: 700;
  letter-spacing: 1.5rpx;
}

.cohort-title {
  margin-top: 2rpx;
  color: #2b4059;
  font-size: 21rpx;
  font-weight: 650;
}

.cohort-options {
  display: flex;
  padding: 4rpx;
  border-radius: 16rpx;
  background: #e9eef2;
}

.cohort-option {
  min-width: 108rpx;
  padding: 12rpx 18rpx;
  border-radius: 13rpx;
  color: #718397;
  font-size: 19rpx;
  font-weight: 600;
  text-align: center;
}

.cohort-option-active {
  background: linear-gradient(120deg, #005bac, #16738a);
  color: #ffffff;
  box-shadow: 0 6rpx 15rpx rgba(11, 79, 156, 0.2);
}

.top-reset-panel {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(183, 139, 75, 0.35);
  border-radius: 22rpx;
  background: linear-gradient(135deg, #111f2c 0%, #243c4d 64%, #365564 100%);
  box-shadow: 0 12rpx 30rpx rgba(15, 32, 51, 0.18);
}

.top-reset-mark {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(157, 190, 219, 0.32);
  border-radius: 14rpx;
  background: rgba(122, 161, 196, 0.12);
  color: #b7d1e7;
  font-size: 25rpx;
}

.top-reset-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  margin-left: 13rpx;
}

.top-reset-title {
  color: #f0f6fc;
  font-size: 21rpx;
  font-weight: 650;
}

.top-reset-subtitle {
  margin-top: 3rpx;
  overflow: hidden;
  color: #9eb1c3;
  font-size: 17rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.top-reset-action {
  flex: 0 0 auto;
  margin-left: 12rpx;
  padding: 9rpx 16rpx;
  border: 1rpx solid #6e879d;
  border-radius: 11rpx;
  background: #111d29;
  color: #dce9f5;
  font-size: 18rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
}

.top-reset-hover {
  background: #26394c;
}

.top-reset-disabled {
  opacity: 0.55;
}

.picker-card {
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 18rpx 50rpx rgba(16, 51, 91, 0.12);
}

.picker-copy {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.picker-kicker {
  color: #2c79c9;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.picker-title {
  color: #6e7d90;
  font-size: 23rpx;
}

.grade-options {
  display: flex;
  margin-top: 19rpx;
}

.grade-option {
  display: flex;
  height: 66rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e1e9f3;
  border-radius: 15rpx;
  background: #f7faff;
  color: #697b90;
  font-size: 19rpx;
  font-weight: 550;
  transition: background 0.15s ease, color 0.15s ease;
}

.grade-option + .grade-option {
  margin-left: 8rpx;
}

.grade-option-active {
  border-color: #0b4f9c;
  background: #0b4f9c;
  color: #ffffff;
  font-weight: 650;
  box-shadow: 0 7rpx 16rpx rgba(11, 79, 156, 0.18);
}

.grade-note {
  margin-top: 12rpx;
  color: #8f9cab;
  font-size: 19rpx;
  line-height: 1.55;
}

.picker-divider {
  height: 1rpx;
  margin: 24rpx 0 21rpx;
  background: #eef2f7;
}

.picker-copy-college {
  margin-bottom: 1rpx;
}

.college-select {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 22rpx;
  border: 1rpx solid #e2eaf4;
  border-radius: 22rpx;
  background: #f7faff;
}

.college-select-empty {
  border-style: dashed;
  background: #fbfdff;
}

.college-badge {
  display: flex;
  width: 74rpx;
  height: 74rpx;
  flex: 0 0 74rpx;
  align-items: center;
  justify-content: center;
  border-radius: 21rpx;
  background: #0b4f9c;
  color: #ffffff;
  font-size: 33rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 18rpx rgba(11, 79, 156, 0.2);
}

.college-badge-empty {
  background: #e9f1fa;
  color: #6d87a2;
  box-shadow: none;
}

.college-text {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  margin-left: 20rpx;
}

.college-name {
  overflow: hidden;
  color: #15273f;
  font-size: 29rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.college-hint {
  margin-top: 4rpx;
  color: #93a0b0;
  font-size: 21rpx;
}

.select-chevron {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
  color: #2c76c2;
  font-size: 34rpx;
}

.cohort-badge {
  padding: 8rpx 17rpx;
  border: 1rpx solid #d7e5f6;
  border-radius: 18rpx;
  background: #edf4fd;
  color: #0b4f9c;
  font-size: 20rpx;
  font-weight: 650;
}

.college-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 34rpx;
  padding: 44rpx 32rpx;
  border-style: dashed;
  text-align: center;
}

.college-empty-mark {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: #edf4fd;
  color: #4b7fb4;
  font-size: 30rpx;
  font-weight: 650;
}

.college-empty-title {
  margin-top: 18rpx;
  color: #354c67;
  font-size: 26rpx;
  font-weight: 650;
}

.college-empty-copy {
  max-width: 520rpx;
  margin-top: 8rpx;
  color: #92a0ae;
  font-size: 20rpx;
  line-height: 1.7;
}

.major-card {
  overflow: hidden;
  margin-bottom: 24rpx;
  padding: 30rpx 28rpx 26rpx;
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}

.major-card-hover {
  transform: translateY(2rpx);
  box-shadow: 0 10rpx 24rpx rgba(22, 54, 96, 0.08);
}

.major-card-top {
  display: flex;
  align-items: flex-start;
}

.major-number {
  width: 60rpx;
  padding-top: 5rpx;
  color: #adc6e3;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 25rpx;
  font-weight: 700;
}

.major-title-wrap {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.major-name {
  color: #14263e;
  font-size: 35rpx;
  font-weight: 720;
  line-height: 1.35;
}

.major-en {
  margin-top: 7rpx;
  color: #a1adbb;
  font-size: 18rpx;
  letter-spacing: 0.3rpx;
  line-height: 1.45;
}

.card-arrow {
  display: flex;
  width: 50rpx;
  height: 50rpx;
  flex: 0 0 50rpx;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
  border-radius: 50%;
  background: #edf4fc;
  color: #1d69b9;
  font-size: 27rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 22rpx;
}

.tag {
  margin: 0 10rpx 8rpx 0;
  padding: 7rpx 14rpx;
  border-radius: 11rpx;
  background: #f2f5f8;
  color: #67778a;
  font-size: 19rpx;
}

.tag-blue {
  background: #e9f2fd;
  color: #0b579f;
}

.major-summary {
  margin-top: 12rpx;
  color: #708094;
  font-size: 23rpx;
  line-height: 1.7;
}

.major-metrics {
  display: flex;
  margin-top: 24rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #eef2f7;
  border-bottom: 1rpx solid #eef2f7;
}

.metric {
  display: flex;
  width: 33.33%;
  flex-direction: column;
  border-right: 1rpx solid #edf1f6;
}

.metric:nth-child(2) {
  padding-left: 22rpx;
}

.metric-right {
  padding-left: 22rpx;
  border-right: 0;
}

.metric-value {
  color: #17365b;
  font-size: 31rpx;
  font-weight: 720;
  line-height: 1.1;
}

.metric-label {
  margin-top: 7rpx;
  color: #96a2b1;
  font-size: 19rpx;
}

.card-progress-head {
  display: flex;
  justify-content: space-between;
  margin-top: 22rpx;
  color: #7d8b9d;
  font-size: 21rpx;
}

.card-progress-value {
  color: #0b579f;
  font-weight: 700;
}

.card-progress-track {
  overflow: hidden;
  height: 9rpx;
  margin-top: 10rpx;
  border-radius: 9rpx;
  background: #edf2f7;
}

.card-progress-fill {
  height: 100%;
  border-radius: 9rpx;
  background: linear-gradient(90deg, #0b4f9c, #49a0ee);
  transform-origin: left center;
  animation: bar-grow 0.5s ease both;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
}

.footer-note {
  color: #a0aab7;
  font-size: 19rpx;
}

.open-board {
  color: #0b579f;
  font-size: 23rpx;
  font-weight: 650;
}

.notice-card {
  display: flex;
  margin-top: 12rpx;
  padding: 26rpx;
  border: 1rpx solid #dce7f4;
  border-radius: 24rpx;
  background: #edf4fc;
}

.notice-icon {
  display: flex;
  width: 40rpx;
  height: 40rpx;
  flex: 0 0 40rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #0b4f9c;
  color: #ffffff;
  font-family: Georgia, serif;
  font-size: 24rpx;
  font-weight: 700;
}

.notice-body {
  display: flex;
  flex: 1;
  flex-direction: column;
  margin-left: 17rpx;
}

.notice-title {
  color: #20456e;
  font-size: 24rpx;
  font-weight: 650;
}

.notice-text {
  margin-top: 7rpx;
  color: #6c8198;
  font-size: 21rpx;
  line-height: 1.7;
}

.page-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 52rpx 0 18rpx;
  color: #a5afbb;
  font-size: 18rpx;
  line-height: 1.9;
  letter-spacing: 1rpx;
}

.grade-sheet-mask {
  position: fixed;
  z-index: 100;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(12, 28, 49, 0.52);
}

.grade-sheet {
  width: 100%;
  padding: 18rpx 34rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 34rpx 34rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -18rpx 60rpx rgba(9, 32, 61, 0.18);
  animation: sheet-up 0.24s ease both;
}

@keyframes sheet-up {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.sheet-handle {
  width: 66rpx;
  height: 7rpx;
  margin: 0 auto 22rpx;
  border-radius: 7rpx;
  background: #dfe6ee;
}

.sheet-kicker {
  color: #3e78b3;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 1.5rpx;
}

.sheet-title {
  margin-top: 7rpx;
  color: #162b47;
  font-size: 36rpx;
  font-weight: 720;
  line-height: 1.35;
}

.sheet-subtitle {
  margin-top: 7rpx;
  color: #929fad;
  font-size: 20rpx;
}

.sheet-grade-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 27rpx -5rpx 5rpx;
}

.sheet-grade-option {
  display: flex;
  width: calc(25% - 10rpx);
  height: 70rpx;
  align-items: center;
  justify-content: center;
  margin: 0 5rpx 12rpx;
  border: 1rpx solid #dfe7f0;
  border-radius: 16rpx;
  background: #f7faff;
  color: #64778d;
  font-size: 21rpx;
  font-weight: 550;
}

.sheet-grade-active {
  border-color: #0b4f9c;
  background: #0b4f9c;
  color: #ffffff;
  font-weight: 680;
  box-shadow: 0 7rpx 18rpx rgba(11, 79, 156, 0.2);
}

.sheet-grade-note {
  margin-top: 10rpx;
  padding: 14rpx 16rpx;
  border-radius: 13rpx;
  background: #eef5fd;
  color: #6f8298;
  font-size: 18rpx;
  line-height: 1.6;
}

.sheet-confirm {
  display: flex;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  margin-top: 23rpx;
  border-radius: 20rpx;
  background: linear-gradient(120deg, #0b4f9c, #2178c8);
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
  box-shadow: 0 10rpx 24rpx rgba(11, 79, 156, 0.2);
}

.sheet-confirm-hover {
  opacity: 0.9;
}

.sheet-cancel {
  padding: 20rpx 0 4rpx;
  color: #97a3b0;
  font-size: 21rpx;
  text-align: center;
}
