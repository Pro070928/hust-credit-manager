<view class="index-page page-shell">
  <view class="hero">
    <view class="hero-orbit orbit-one"></view>
    <view class="hero-orbit orbit-two"></view>
    <view class="brand-row">
      <view class="brand-mark">
        <text class="brand-mark-letter">H</text>
        <view class="brand-mark-line"></view>
      </view>
      <view class="brand-copy">
        <text class="brand-name">hust学分管家</text>
        <text class="brand-en" style="width: 281rpx; height: 41rpx; display: block; box-sizing: border-box">HUST CREDIT COMPANION MADE BY EIC-HUSTER
        </text>
        <text class="brand-motto">明德厚学 · 求是创新</text>
      </view>
    </view>

    <view class="unofficial-badge">
      <text class="unofficial-badge-mark">非官方</text>
      <text>个人开发的学分自查工具</text>
    </view>

    <view class="hero-address">1037 LUOYU ROAD · WUHAN</view>
    <view class="hero-title">修满每一分，<text>走稳1037号森林。</text></view>
    <view class="hero-copy">喻家山麓，东湖之畔。收录 2023–2026 级培养方案；个人开发、非官方工具，结果仅供自查。</view>
    <view class="hero-watermark">1037</view>

    <view class="hero-stats">
      <view class="hero-stat">
        <text class="stat-value">{{collegeCount}}</text>
        <text class="stat-label">学院</text>
      </view>
      <view class="stat-divider"></view>
      <view class="hero-stat">
        <text class="stat-value">{{majorCount}}</text>
        <text class="stat-label">专业方案</text>
      </view>
      <view class="stat-divider"></view>
      <view class="hero-stat">
        <text class="stat-value">{{volumeCount}}</text>
        <text class="stat-label">培养分册</text>
      </view>
    </view>
  </view>

  <view class="content">
    <view class="cohort-panel rise-in">
      <view class="cohort-copy">
        <text class="cohort-kicker">HUST · 1037 培养档案</text>
        <text class="cohort-title">选择入学年级</text>
      </view>
      <view class="cohort-options">
        <view
          wx:for="{{cohortList}}"
          wx:key="id"
          class="cohort-option {{item.id === cohort ? 'cohort-option-active' : ''}}"
          data-cohort="{{item.id}}"
          bindtap="onCohortSelect"
        >
          {{item.label}}
        </view>
      </view>
    </view>

    <view class="top-reset-panel rise-in">
      <view class="top-reset-mark">↺</view>
      <view class="top-reset-copy">
        <text class="top-reset-title">数据重置</text>
        <text class="top-reset-subtitle">清除全部错误勾选、学时和云端记录</text>
      </view>
      <view
        class="top-reset-action {{resetting ? 'top-reset-disabled' : ''}}"
        bindtap="resetAllData"
        hover-class="top-reset-hover"
      >
        {{resetting ? '重置中' : '重置'}}
      </view>
    </view>

    <view class="picker-card card-surface rise-in">
      <view class="picker-copy">
        <text class="picker-kicker">STEP 01</text>
        <text class="picker-title">选择所在学院</text>
      </view>
      <picker
        mode="selector"
        range="{{collegeNames}}"
        value="{{pickerValue}}"
        bindchange="onCollegeChange"
      >
        <view class="college-select {{hasCollege ? '' : 'college-select-empty'}}">
          <view class="college-badge {{hasCollege ? '' : 'college-badge-empty'}}">
            {{hasCollege ? currentCollege.initial : '院'}}
          </view>
          <view class="college-text">
            <text class="college-name">{{hasCollege ? currentCollege.name : '请选择学院'}}</text>
            <text class="college-hint">{{hasCollege ? '点击切换学院' : '选择后显示该学院的专业方案'}}</text>
          </view>
          <view class="select-chevron">⌄</view>
        </view>
      </picker>
    </view>

    <block wx:if="{{hasCollege}}">
    <view class="section-heading">
      <view>
        <text class="section-title">专业列表</text>
        <text class="section-subtitle">{{cohortLabel}} · {{currentCollege.shortName}} · 共 {{majorCards.length}} 个专业方案</text>
      </view>
      <text class="cohort-badge">{{cohortLabel}}</text>
    </view>

    <block wx:for="{{majorCards}}" wx:key="id">
      <view
        class="major-card card-surface rise-in"
        style="animation-delay: {{index * 60}}ms;"
        data-id="{{item.id}}"
        bindtap="openMajor"
        hover-class="major-card-hover"
      >
        <view class="major-card-top">
          <view class="major-number">0{{index + 1}}</view>
          <view class="major-title-wrap">
            <text class="major-name">{{item.name}}</text>
            <text wx:if="{{item.englishName}}" class="major-en">{{item.englishName}}</text>
          </view>
          <view class="card-arrow">→</view>
        </view>

        <view class="tag-row">
          <text class="tag tag-blue">{{item.degree}}</text>
          <text class="tag">{{item.duration}}</text>
          <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="tag">{{tag}}</text>
        </view>

        <view class="major-summary">{{item.summary}}</view>

        <view class="major-metrics">
          <view class="metric">
            <text class="metric-value">{{item.totalCreditsText}}</text>
            <text class="metric-label">毕业总学分</text>
          </view>
          <view class="metric">
            <text class="metric-value">{{item.moduleCount}}</text>
            <text class="metric-label">学分模块</text>
          </view>
          <view class="metric metric-right">
            <text class="metric-value">{{item.earnedText}}</text>
            <text class="metric-label">示例已修</text>
          </view>
        </view>

        <view class="card-progress-head">
          <text>自查进度</text>
          <text class="card-progress-value">{{item.percent}}%</text>
        </view>
        <view class="card-progress-track">
          <view class="card-progress-fill" style="{{item.progressStyle}}"></view>
        </view>

        <view class="card-footer">
          <text class="footer-note">{{item.selectedGradeLabel}} · {{item.duration}}学制</text>
          <text class="open-board">选择年级 →</text>
        </view>
      </view>
    </block>
    </block>

    <view wx:else class="college-empty card-surface">
      <view class="college-empty-mark">院</view>
      <text class="college-empty-title">请先选择所在学院</text>
      <text class="college-empty-copy">选择学院后，这里会显示对应专业的卡片、学制和学分方案。</text>
    </view>

    <view class="notice-card">
      <view class="notice-icon">i</view>
      <view class="notice-body">
        <text class="notice-title">个人开发与非官方说明</text>
        <text class="notice-text">本工具不接入学校任何系统，培养方案整理自公开资料，学分、学时和预警结果仅供个人自查，正式认定以学校教务系统和培养方案为准。</text>
        <text class="notice-text">当前覆盖 2023–2026 级共 684 个专业方案；2023/2024 部分旧版医科数据来自 OCR 文档，专业名称和学制已按目录校正。</text>
      </view>
    </view>

    <view class="page-footer">
      <text>1037号森林 · 华中科技大学</text>
      <text>明德厚学 · 求是创新 · 自主自查</text>
      <text>个人开发 · 非官方工具 · 结果仅供参考</text>
    </view>
  </view>

  <view wx:if="{{gradeSheetVisible}}" class="grade-sheet-mask" bindtap="closeGradeSheet">
    <view class="grade-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-kicker">本专业学制 {{sheetMajor.duration}}</view>
      <view class="sheet-title">{{sheetMajor.name}}</view>
      <view class="sheet-subtitle">{{sheetMajor.degree}} · 请选择当前年级</view>

      <view class="sheet-grade-grid">
        <view
          wx:for="{{sheetGradeOptions}}"
          wx:key="*this"
          class="sheet-grade-option {{index === sheetGradeIndex ? 'sheet-grade-active' : ''}}"
          data-index="{{index}}"
          bindtap="onSheetGradeSelect"
        >
          {{item}}
        </view>
      </view>

      <view class="sheet-grade-note">{{sheetGradeNote}}</view>
      <button class="sheet-confirm" bindtap="confirmMajor" hover-class="sheet-confirm-hover">
        进入学分看板
      </button>
      <view class="sheet-cancel" bindtap="closeGradeSheet">取消</view>
    </view>
  </view>
</view>
