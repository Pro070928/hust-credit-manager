.warning-page {
  background: transparent;
}

.warning-hero {
  position: relative;
  overflow: hidden;
  padding: 32rpx 34rpx 74rpx;
  background:
    radial-gradient(circle at 86% 4%, rgba(190, 80, 85, 0.23), transparent 25%),
    radial-gradient(circle at 8% 102%, rgba(37, 139, 144, 0.25), transparent 34%),
    linear-gradient(145deg, #17263b 0%, #003a70 50%, #116676 100%);
  color: #ffffff;
}

.warning-hero::before {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background:
    linear-gradient(rgba(225, 236, 244, 0.045) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(225, 236, 244, 0.045) 1rpx, transparent 1rpx);
  background-size: 50rpx 50rpx;
  mask-image: linear-gradient(to bottom, #000 5%, rgba(0, 0, 0, 0.5) 65%, transparent 100%);
  pointer-events: none;
  content: "";
}

.warning-hero::after {
  position: absolute;
  right: -25rpx;
  bottom: 0;
  width: 350rpx;
  height: 210rpx;
  background: repeating-linear-gradient(
    90deg,
    rgba(211, 231, 242, 0.09) 0,
    rgba(211, 231, 242, 0.09) 2rpx,
    transparent 2rpx,
    transparent 30rpx
  );
  transform: skewX(-6deg);
  pointer-events: none;
  content: "";
}

.warning-seal {
  position: absolute;
  top: 40rpx;
  right: -8rpx;
  color: transparent;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 150rpx;
  font-weight: 700;
  letter-spacing: -6rpx;
  line-height: 1;
  -webkit-text-stroke: 1rpx rgba(218, 182, 119, 0.2);
  pointer-events: none;
}

.warning-rings {
  position: absolute;
  top: -125rpx;
  right: -105rpx;
  width: 390rpx;
  height: 390rpx;
  border: 1rpx solid rgba(220, 185, 123, 0.22);
  border-radius: 50%;
  box-shadow:
    0 0 0 34rpx rgba(255, 255, 255, 0.024),
    0 0 0 76rpx rgba(255, 255, 255, 0.016);
}

.warning-rings::after {
  position: absolute;
  top: 90rpx;
  left: 90rpx;
  width: 205rpx;
  height: 205rpx;
  border: 1rpx solid rgba(220, 185, 123, 0.17);
  border-radius: 50%;
  content: "";
}

.alert-mark {
  position: relative;
  z-index: 1;
  display: flex;
  width: 65rpx;
  height: 65rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(247, 208, 188, 0.32);
  border-radius: 20rpx 20rpx 20rpx 7rpx;
  background: rgba(177, 68, 74, 0.24);
  color: #ffd8d4;
  font-family: Georgia, serif;
  font-size: 36rpx;
  font-weight: 700;
}

.warning-kicker {
