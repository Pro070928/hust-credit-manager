  z-index: 1;
  margin-top: 24rpx;
  color: #e8c28d;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2.4rpx;
}

.warning-title {
  position: relative;
  z-index: 1;
  margin-top: 8rpx;
  font-size: 48rpx;
  font-weight: 720;
  letter-spacing: -1rpx;
}

.warning-copy {
  position: relative;
  z-index: 1;
  margin-top: 11rpx;
  color: rgba(229, 239, 245, 0.7);
  font-size: 21rpx;
}

.warning-unofficial {
