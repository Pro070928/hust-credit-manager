}

.academic-symbol-neutral {
  background: #e8f1fb;
  color: #286ba8;
}

.academic-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  margin-left: 14rpx;
}

.academic-title-row {
  display: flex;
  align-items: center;
}

.academic-title {
  color: #21344d;
  font-size: 25rpx;
  font-weight: 680;
}

.academic-status {
  margin-left: 10rpx;
  padding: 4rpx 10rpx;
  border-radius: 9rpx;
  font-size: 17rpx;
