.status-symbol-warning {
  background: #fbe7e9;
  color: #c1464e;
}

.status-symbol-info {
  background: #eaf2fc;
  color: #2466a8;
}

.rule-body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  margin-left: 16rpx;
}

.rule-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rule-title {
  color: #1b2d45;
  font-size: 25rpx;
  font-weight: 650;
}

.rule-status {
  margin-left: 12rpx;
  font-size: 18rpx;
  font-weight: 600;
  white-space: nowrap;
}

.status-text-ok {
  color: #2f8369;
}

.status-text-warning {
  color: #c34850;
}

.status-text-info {
  color: #3c76ae;
}

.rule-description {
  margin-top: 7rpx;
  color: #7c8b9d;
  font-size: 21rpx;
  line-height: 1.65;
}

.rule-value {
  align-self: flex-start;
  margin-top: 10rpx;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  background: #f1f5f9;
  color: #60758c;
  font-size: 18rpx;
}

.calc-note {
  margin-top: 26rpx;
  padding: 24rpx;
  background: #f9fbfd;
  box-shadow: none;
}

.calc-note-title {
  color: #425b76;
  font-size: 22rpx;
  font-weight: 650;
}

.calc-note-text {
  margin-top: 7rpx;
  color: #8492a2;
  font-size: 20rpx;
  line-height: 1.75;
}

.dashboard-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 44rpx 0 12rpx;
  color: #a7b1bd;
  font-size: 18rpx;
  line-height: 1.9;
}

.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8a97a8;
  font-size: 24rpx;
}

.loading-ring {
  width: 34rpx;
  height: 34rpx;
  margin-right: 14rpx;
  border: 4rpx solid #dce7f4;
  border-top-color: #0b4f9c;
  border-radius: 50%;
  animation: rotate 0.8s linear infinite;
}

@keyframes rotate {
  to {
    transform: rotate(360deg);
  }
}
