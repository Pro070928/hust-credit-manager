}

.academic-neutral {
  border-color: #dce8f5;
  background: #f8fbff;
}

.academic-top {
  display: flex;
  align-items: flex-start;
}

.academic-symbol {
  display: flex;
  width: 45rpx;
  height: 45rpx;
  flex: 0 0 45rpx;
  align-items: center;
  justify-content: center;
  border-radius: 13rpx;
