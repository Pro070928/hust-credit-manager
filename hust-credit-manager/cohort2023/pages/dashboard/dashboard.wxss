}

.academic-status-red {
  background: #fae4e6;
  color: #b93d45;
}

.academic-status-yellow {
  background: #f9ebcf;
  color: #93611a;
}

.academic-status-safe {
  background: #e3f3ed;
  color: #2c7b63;
}

.academic-status-neutral {
  background: #e9f2fc;
  color: #2c6ba5;
}

.academic-summary {
  margin-top: 6rpx;
  color: #7d8c9d;
  font-size: 20rpx;
  line-height: 1.6;
}

.academic-arrow {
  margin-left: 10rpx;
  color: #8ea0b3;
  font-size: 24rpx;
}

.academic-thresholds {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding-left: 59rpx;
}

.threshold-chip {
  display: flex;
  align-items: baseline;
  margin-right: 10rpx;
  padding: 5rpx 10rpx;
  border-radius: 9rpx;
  background: #faf0d8;
}

.threshold-chip-red {
  background: #f9e7e9;
}

.threshold-name {
  color: #8c7349;
  font-size: 16rpx;
}

.threshold-chip-red .threshold-name {
  color: #a66d71;
}

.threshold-number {
  margin-left: 5rpx;
  color: #6f5528;
  font-family: Georgia, serif;
  font-size: 20rpx;
  font-weight: 700;
}

.threshold-chip-red .threshold-number {
  color: #a13d44;
}

.threshold-grade {
  margin-left: auto;
  color: #9ba6b1;
  font-size: 16rpx;
}

.academic-action {
  margin-top: 15rpx;
  padding: 13rpx 15rpx;
  border-radius: 12rpx;
  background: #fae5e7;
  color: #aa3d44;
  font-size: 19rpx;
  font-weight: 600;
  line-height: 1.55;
}

.academic-safe-line {
  display: flex;
  justify-content: space-between;
  margin-top: 13rpx;
  padding-left: 59rpx;
  color: #95a2af;
  font-size: 17rpx;
}

.academic-more {
  color: #4279ad;
  font-weight: 600;
}

.status-summary {
  padding: 7rpx 15rpx;
  border-radius: 15rpx;
  font-size: 19rpx;
  font-weight: 600;
}

.has-warning {
  background: #fdecee;
  color: #c14b52;
}

.all-clear {
  background: #e8f6f1;
  color: #27765e;
}

.module-card {
  position: relative;
  overflow: hidden;
  margin-bottom: 18rpx;
  padding: 26rpx 26rpx 22rpx;
}

.module-warning::before {
  position: absolute;
  top: 30rpx;
  bottom: 30rpx;
  left: 0;
  width: 5rpx;
  border-radius: 0 5rpx 5rpx 0;
  background: #d6565e;
  content: "";
}

.module-ok::before {
  position: absolute;
  top: 30rpx;
  bottom: 30rpx;
  left: 0;
  width: 5rpx;
  border-radius: 0 5rpx 5rpx 0;
  background: #3e9b7f;
  content: "";
}

.module-top {
  display: flex;
  align-items: flex-start;
}

.module-index {
  display: flex;
  width: 43rpx;
  height: 43rpx;
  flex: 0 0 43rpx;
  align-items: center;
  justify-content: center;
  margin-top: 2rpx;
  border-radius: 13rpx;
  background: #f0f4f9;
  color: #77879b;
  font-family: Georgia, serif;
  font-size: 20rpx;
  font-weight: 700;
}

.module-heading {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  margin-left: 15rpx;
}

.module-name-row {
  display: flex;
  align-items: center;
}

.module-name {
  color: #1a2d47;
  font-size: 28rpx;
  font-weight: 680;
}

.module-category {
  margin-left: 10rpx;
  padding: 3rpx 9rpx;
  border-radius: 8rpx;
  background: #f2f6fa;
  color: #8a98a9;
  font-size: 16rpx;
}

.module-description {
  margin-top: 5rpx;
  color: #98a4b2;
  font-size: 19rpx;
}

.module-status {
  flex: 0 0 auto;
  margin-left: 10rpx;
  padding: 5rpx 11rpx;
  border-radius: 10rpx;
  font-size: 17rpx;
  font-weight: 650;
}

.status-ok {
  background: #e8f6f1;
  color: #2e7c63;
}

.status-warning {
  background: #fdecee;
  color: #c34a51;
}

.module-numbers {
  display: flex;
  align-items: baseline;
  margin: 23rpx 0 12rpx 58rpx;
}

.module-earned {
  color: #17375d;
  font-family: Georgia, serif;
  font-size: 37rpx;
  font-weight: 700;
  line-height: 1;
}

.module-min {
  margin-left: 7rpx;
  color: #8e9ba8;
  font-size: 20rpx;
}

.module-course-count {
  margin-left: 7rpx;
  color: #8e9ba8;
  font-size: 19rpx;
}

.module-track {
  overflow: hidden;
  height: 9rpx;
  margin-left: 58rpx;
  border-radius: 9rpx;
  background: #eef2f6;
}

.module-fill {
  height: 100%;
  border-radius: 9rpx;
  transform-origin: left center;
  animation: bar-grow 0.55s ease both;
}

.module-fill-ok {
  background: linear-gradient(90deg, #318f75, #66bca3);
}

.module-fill-warning {
  background: linear-gradient(90deg, #c8444c, #e57a7f);
}

.module-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 11rpx 0 0 58rpx;
  font-size: 18rpx;
}

.module-warning-text {
  color: #bf4a52;
}

.module-ok-text {
  color: #438a73;
}

.module-percent {
  color: #a1acb8;
  font-family: Georgia, serif;
}

.rules-heading {
  margin-top: 38rpx;
}

.rule-card {
  display: flex;
  margin-bottom: 14rpx;
  padding: 22rpx;
  border: 1rpx solid #e7edf4;
  border-radius: 22rpx;
  background: #ffffff;
}

.status-bg-warning {
  border-color: #f2dfe1;
  background: #fffafa;
}

.status-bg-ok {
  border-color: #dcefe8;
  background: #fbfffd;
}

.rule-symbol {
  display: flex;
  width: 43rpx;
  height: 43rpx;
  flex: 0 0 43rpx;
  align-items: center;
  justify-content: center;
  margin-top: 1rpx;
  border-radius: 50%;
  font-family: Georgia, serif;
  font-size: 22rpx;
  font-weight: 700;
}

.status-symbol-ok {
  background: #e2f4ed;
  color: #2e8268;
