page {
  min-height: 100%;
  background-color: #f3f1ea;
  background-image:
    radial-gradient(circle at 5% 2%, rgba(0, 91, 172, 0.08), transparent 28%),
    radial-gradient(circle at 100% 18%, rgba(18, 116, 140, 0.07), transparent 30%),
    radial-gradient(circle at 50% 105%, rgba(183, 139, 75, 0.07), transparent 34%),
    linear-gradient(rgba(0, 58, 112, 0.025) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(0, 58, 112, 0.025) 1rpx, transparent 1rpx);
  background-size: auto, auto, auto, 48rpx 48rpx, 48rpx 48rpx;
  color: #16243a;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

view,
text,
button,
picker,
scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  color: inherit;
  font-size: inherit;
  line-height: inherit;
  border-radius: 0;
}

button::after {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.card-surface {
  background: #ffffff;
  border: 1rpx solid rgba(14, 58, 112, 0.06);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(18, 49, 84, 0.065);
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 42rpx 0 22rpx;
}

.section-title {
  display: block;
  color: #12233c;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.section-subtitle {
  display: block;
  margin-top: 5rpx;
  color: #8a97a8;
  font-size: 23rpx;
}

.primary-button {
  display: flex;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #005bac;
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 58, 112, 0.2);
}

.primary-button.button-hover {
  background: #003f7d;
  transform: translateY(1rpx);
}

.ghost-button {
  display: flex;
  height: 84rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #dce6f3;
  border-radius: 20rpx;
  background: #ffffff;
  color: #2f4e72;
  font-size: 27rpx;
  font-weight: 600;
}

.muted {
  color: #8a97a8;
}

.safe-bottom {
  height: env(safe-area-inset-bottom);
}

@keyframes rise-in {
  from {
    opacity: 0;
    transform: translateY(18rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes bar-grow {
  from {
    transform: scaleX(0);
  }
  to {
    transform: scaleX(1);
  }
}

.rise-in {
  animation: rise-in 0.42s ease both;
}
